# Copy this file to .env and fill in your values. Never commit real credentials.
# Restart the application after changing environment configuration.
# Existing deployment environment variables take precedence over .env values.

# Azure DevOps: enter the organization URL and PAT in Streamlit, not in this file.
# Optional REST API version override:
AZURE_DEVOPS_API_VERSION=7.1

# Groq (required for AI test generation; the UI can also supply this provider key)
GROQ_API_KEY=

# Hugging Face (required for live document embeddings)
HUGGINGFACEHUB_API_TOKEN=

# Local storage and embedding version tracking
ENGINEERING_DATA_DIR=.local/test-engineering
ENGINEERING_EMBEDDING_VERSION=google/embeddinggemma-300m:v1

# Deployment-controlled source grants; UI users cannot expand these grants.
ENGINEERING_ALLOWED_SOURCES=azure_devops,confluence,files,approved_tests
